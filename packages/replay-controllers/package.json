{
  "name": "@rrweb/replay-controllers",
  "version": "2.2.1",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "devtools",
    "product-analytics",
    "real-user-monitoring",
    "rrweb",
    "@rrweb/replay-controllers"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "yarn turbo run prepublish",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check-types": "tsc -noEmit",
    "prepublish": "tsc -noEmit && vite build",
    "lint": "yarn eslint src/**/*.ts"
  },
  "homepage": "https://github.com/rrweb-io/rrweb/tree/main/packages/replay-controllers#readme",
  "bugs": {
    "url": "https://github.com/rrweb-io/rrweb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrweb-io/rrweb.git",
    "directory": "packages/replay-controllers"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/replay-controllers.cjs",
  "module": "./dist/replay-controllers.js",
  "unpkg": "./dist/replay-controllers.umd.cjs",
  "jsdelivr": "./umd/replay-controllers.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/replay-controllers.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/replay-controllers.cjs"
      }
    }
  },
  "files": [
    "umd",
    "dist",
    "package.json"
  ],
  "devDependencies": {
    "esbuild": "^0.19.0",
    "puppeteer": "^20.9.0",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@rrweb/types": "^2.2.1",
    "@rrweb/replay": "^2.2.1"
  },
  "browserslist": [
    "supports es6-class"
  ]
}
