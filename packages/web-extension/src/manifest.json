{
  "common": {
    "name": "rrweb",
    "description": "Record and replay a browser tab with rrweb. Keep recordings in your browser, or sign in to save them to your rrweb account.",
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "permissions": ["activeTab", "storage", "unlimitedStorage"]
  },
  "v2": {
    "common": {
      "manifest_version": 2,
      "background": {
        "persistent": false,
        "scripts": ["background/index.ts"]
      },
      "browser_action": {
        "default_title": "rrweb",
        "default_popup": "popup/popup.html",
        "browser_style": false
      },
      "options_ui": {
        "page": "options/index.html",
        "open_in_tab": true,
        "chrome_style": false
      },
      "web_accessible_resources": ["**/*.js"]
    },
    "chrome": {},
    "firefox": {
      "description": "Record and replay a browser tab with rrweb. Recordings are kept in your browser.",
      "browser_specific_settings": {
        "gecko": {
          "id": "rrweb@rrweb.io",
          "strict_min_version": "42.0"
        }
      }
    }
  },
  "v3": {
    "common": {
      "manifest_version": 3,
      "background": {
        "service_worker": "background/index.ts",
        "type": "module"
      },
      "action": {
        "default_title": "rrweb",
        "default_popup": "popup/popup.html"
      },
      "options_ui": {
        "page": "options/index.html",
        "open_in_tab": true
      }
    },
    "chrome": {
      "minimum_chrome_version": "116"
    },
    "firefox": {}
  }
}
